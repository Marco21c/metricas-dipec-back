# Copiar este archivo como .env y completar los valores

# Servidor
PORT=4000
# Dirección del tablero (frontend) que puede consultar esta API (varias, separadas por coma)
FRONTEND_URL=http://localhost:5175

# Sesión (login): una clave larga y aleatoria
JWT_SECRET=cambiar-por-una-clave-larga-y-aleatoria

# Base de datos Postgres (usuarios del tablero)
DATABASE_URL=postgres://usuario:contraseña@localhost:5432/metricas_dipec

# ---------- Google Analytics 4 ----------
# 1) Número de la propiedad GA4 (unos 9 dígitos).
#    Lo da quien administra Analytics: Administrar → Detalles de la propiedad.
GA_PROPERTY_ID=

# 2) y 3) Salen del archivo .json de la cuenta de servicio (Google Cloud → Cuentas de servicio → Claves).
#    GA_CLIENT_EMAIL = el valor de "client_email"
#    GA_PRIVATE_KEY  = el valor de "private_key", copiado tal cual entre comillas dobles
#                      (en una sola línea, con los \n incluidos)
GA_CLIENT_EMAIL=
GA_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opcional: dirección del WordPress (para la lista de páginas y noticias)
WORDPRESS_URL=https://dipec.jujuy.gob.ar

# Opcional: cómo se registran las descargas en Google Analytics.
# Hoy el sitio usa el plugin WP File Download: evento "Download" con la dirección del archivo en "event_label".
# Si la página nueva usa la medición estándar de Google: GA_EVENTO_DESCARGA=file_download y GA_DIMENSION_ARCHIVO=linkUrl
GA_EVENTO_DESCARGA=Download
GA_DIMENSION_ARCHIVO=customEvent:event_label

# Opcional: categoría de WordPress que contiene las noticias
WP_CATEGORIA_NOTICIAS=noticias
